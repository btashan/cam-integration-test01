<?xml version="1.0" encoding="UTF-8"?><camel xmlns="http://camel.apache.org/schema/spring">

    <!-- REST Endpoint Tanımı -->
    <rest path="/hello">
        <get path="/hi">
            <to uri="direct:hesapla"/>
        </get>
    </rest>

    <!-- İş Mantığı Rotalaması -->
    <route id="helloHesaplaRoute">
        <from uri="direct:hesapla"/>

        <!-- Groovy Scripting -->
        <setBody>

        </setBody>

        <!-- Otomatik JSON Dönüşümü -->
        <marshal>
            <json/>
        </marshal>
    </route>

</camel>