<?xml version="1.0" encoding="UTF-8"?>
<routes xmlns="http://camel.apache.org/schema/spring">

    <!-- ============================================================= -->
    <!-- ANA ROUTE: her tick'te checkpoint'i okur, PrestaShop'tan      -->
    <!-- guncellenen customer'lari ceker, her birini Odoo'ya yazar,    -->
    <!-- sonra yeni checkpoint'i yazar.                                -->
    <!--                                                                -->
    <!-- Bu route'a bagli onException, direct: ile cagirdigi butun alt -->
    <!-- route'lardan (odoo-login-route, sync-one-customer-route, vb.) -->
    <!-- yakalanmadan yukari tasan hatalari da kapsar - cunku Camel'de -->
    <!-- bir sub-route (direct:) hatayi kendi handle etmezse, hata     -->
    <!-- cagiran route'un error handler'ina geri propagate olur.       -->
    <!-- ============================================================= -->
    <route id="customer-sync-poll-route">
        <onException>
            <exception>java.lang.Exception</exception>
            <handled>
                <constant>true</constant>
            </handled>
            <setProperty name="errorRouteId">
                <simple>${routeId}</simple>
            </setProperty>
            <setProperty name="errorMessage">
                <simple>${exception.message}</simple>
            </setProperty>
            <to uri="direct:handle-integration-error"/>
        </onException>

        <from uri="timer:customerSyncTimer?period={{sync.period.ms}}"/>
        <log message="[customer-sync] Senkronizasyon basladi."/>

        <to uri="direct:read-checkpoint"/>
        <setProperty name="sinceDateUpd">
            <simple>${body}</simple>
        </setProperty>
        <setProperty name="untilDateUpd">
            <simple>${date:now:yyyy-MM-dd HH:mm:ss}</simple>
        </setProperty>
        <log message="[customer-sync] Aralik: ${exchangeProperty.sinceDateUpd} -&gt; ${exchangeProperty.untilDateUpd}"/>

        <to uri="direct:odoo-login"/>
        <setProperty name="odooUid">
            <simple>${body}</simple>
        </setProperty>

        <!-- PrestaShop: bu aralikta guncellenen customer'lari cek -->
        <removeHeaders pattern="*"/>
        <setHeader name="CamelHttpMethod">
            <constant>GET</constant>
        </setHeader>
        <toD uri="{{presta.base.url}}/api/customers?filter%5Bdate_upd%5D=%5B${exchangeProperty.sinceDateUpd}%2C${exchangeProperty.untilDateUpd}%5D&amp;date=1&amp;sort=%5Bdate_upd_ASC%5D&amp;display=%5Bid%2Cfirstname%2Clastname%2Cemail%2Cdate_upd%5D&amp;authMethod=Basic&amp;authUsername={{presta.api.key}}&amp;authPassword=&amp;bridgeEndpoint=true&amp;throwExceptionOnFailure=false"/>
        <convertBodyTo type="java.lang.String"/>
        <log message="[customer-sync] PrestaShop yaniti: ${body}"/>

        <split>
            <xpath>/prestashop/customers/customer</xpath>
            <log message="[customer-sync] Islenen customer node: ${body}"/>
            <script>
                <groovy>resource:file:demo/customer-sync/transform-customer.groovy</groovy>
            </script>
            <to uri="direct:sync-one-customer"/>
        </split>

        <setBody>
            <simple>${exchangeProperty.untilDateUpd}</simple>
        </setBody>
        <to uri="direct:write-checkpoint"/>

        <log message="[customer-sync] Senkronizasyon bitti. Yeni checkpoint: ${exchangeProperty.untilDateUpd}"/>
    </route>

    <!-- ============================================================= -->
    <!-- Tek bir PrestaShop customer'ini Odoo'da bul/olustur/guncelle. -->
    <!-- Gelen body: [id, firstname, lastname, email, dateUpd] Map'i   -->
    <!-- ============================================================= -->
    <route id="sync-one-customer-route">
        <onException>
            <exception>java.lang.Exception</exception>
            <handled>
                <constant>true</constant>
            </handled>
            <setProperty name="errorRouteId">
                <simple>${routeId}</simple>
            </setProperty>
            <setProperty name="errorMessage">
                <simple>${exception.message}</simple>
            </setProperty>
            <to uri="direct:handle-integration-error"/>
        </onException>

        <from uri="direct:sync-one-customer"/>

        <setProperty name="custEmail">
            <simple>${body[email]}</simple>
        </setProperty>
        <setProperty name="custName">
            <simple>${body[firstname]} ${body[lastname]}</simple>
        </setProperty>

        <!-- Odoo'da bu email ile partner var mi? -->
        <removeHeaders pattern="*"/>
        <setHeader name="CamelHttpMethod">
            <constant>POST</constant>
        </setHeader>
        <setHeader name="Content-Type">
            <constant>application/json</constant>
        </setHeader>
        <setBody>
            <simple>{"jsonrpc":"2.0","method":"call","params":{"service":"object","method":"execute_kw","args":["{{odoo.db}}",${exchangeProperty.odooUid},"{{odoo.password}}","res.partner","search_read",[[["email","=","${exchangeProperty.custEmail}"]]],{"fields":["id"],"limit":1}]},"id":2}</simple>
        </setBody>
        <toD uri="{{odoo.base.url}}/jsonrpc?bridgeEndpoint=true"/>
        <convertBodyTo type="java.lang.String"/>
        <unmarshal>
            <json library="Jackson"/>
        </unmarshal>
        <setProperty name="existingPartners">
            <simple>${body[result]}</simple>
        </setProperty>

        <choice>
            <when>
                <simple>${exchangeProperty.existingPartners.size()} &gt; 0</simple>
                <setProperty name="partnerId">
                    <simple>${exchangeProperty.existingPartners[0][id]}</simple>
                </setProperty>
                <removeHeaders pattern="*"/>
                <setHeader name="CamelHttpMethod">
                    <constant>POST</constant>
                </setHeader>
                <setHeader name="Content-Type">
                    <constant>application/json</constant>
                </setHeader>
                <setBody>
                    <simple>{"jsonrpc":"2.0","method":"call","params":{"service":"object","method":"execute_kw","args":["{{odoo.db}}",${exchangeProperty.odooUid},"{{odoo.password}}","res.partner","write",[[${exchangeProperty.partnerId}],{"name":"${exchangeProperty.custName}","email":"${exchangeProperty.custEmail}"}]]},"id":3}</simple>
                </setBody>
                <toD uri="{{odoo.base.url}}/jsonrpc?bridgeEndpoint=true"/>
                <log message="[customer-sync] Odoo partner guncellendi: id=${exchangeProperty.partnerId} email=${exchangeProperty.custEmail}"/>
            </when>
            <otherwise>
                <removeHeaders pattern="*"/>
                <setHeader name="CamelHttpMethod">
                    <constant>POST</constant>
                </setHeader>
                <setHeader name="Content-Type">
                    <constant>application/json</constant>
                </setHeader>
                <setBody>
                    <simple>{"jsonrpc":"2.0","method":"call","params":{"service":"object","method":"execute_kw","args":["{{odoo.db}}",${exchangeProperty.odooUid},"{{odoo.password}}","res.partner","create",[{"name":"${exchangeProperty.custName}","email":"${exchangeProperty.custEmail}","customer_rank":1}]]},"id":4}</simple>
                </setBody>
                <toD uri="{{odoo.base.url}}/jsonrpc?bridgeEndpoint=true"/>
                <log message="[customer-sync] Odoo partner olusturuldu: email=${exchangeProperty.custEmail}"/>
            </otherwise>
        </choice>
    </route>

    <!-- ============================================================= -->
    <!-- Odoo JSON-RPC login: db/kullanici/sifre ile uid alir.         -->
    <!-- ============================================================= -->
    <route id="odoo-login-route">
        <onException>
            <exception>java.lang.Exception</exception>
            <handled>
                <constant>true</constant>
            </handled>
            <setProperty name="errorRouteId">
                <simple>${routeId}</simple>
            </setProperty>
            <setProperty name="errorMessage">
                <simple>${exception.message}</simple>
            </setProperty>
            <to uri="direct:handle-integration-error"/>
        </onException>

        <from uri="direct:odoo-login"/>
        <removeHeaders pattern="*"/>
        <setHeader name="CamelHttpMethod">
            <constant>POST</constant>
        </setHeader>
        <setHeader name="Content-Type">
            <constant>application/json</constant>
        </setHeader>
        <setBody>
            <simple>{"jsonrpc":"2.0","method":"call","params":{"service":"common","method":"login","args":["{{odoo.db}}","{{odoo.username}}","{{odoo.password}}"]},"id":1}</simple>
        </setBody>
        <toD uri="{{odoo.base.url}}/jsonrpc?bridgeEndpoint=true"/>
        <convertBodyTo type="java.lang.String"/>
        <unmarshal>
            <json library="Jackson"/>
        </unmarshal>
        <choice>
            <when>
                <simple>${body[result]} == null</simple>
                <throwException exceptionType="java.lang.IllegalStateException"
                                 message="Odoo login basarisiz - db/kullanici/sifre bilgilerini kontrol et."/>
            </when>
        </choice>
        <setBody>
            <simple>${body[result]}</simple>
        </setBody>
    </route>

    <!-- ============================================================= -->
    <!-- Checkpoint okuma: mock K/V store dosyasindan son date_upd'i   -->
    <!-- okur (Camelyne'in gercek K/V config DB'sinin yerini tutar).   -->
    <!-- ============================================================= -->
    <route id="read-checkpoint-route">
        <onException>
            <exception>java.lang.Exception</exception>
            <handled>
                <constant>true</constant>
            </handled>
            <setProperty name="errorRouteId">
                <simple>${routeId}</simple>
            </setProperty>
            <setProperty name="errorMessage">
                <simple>${exception.message}</simple>
            </setProperty>
            <to uri="direct:handle-integration-error"/>
        </onException>

        <from uri="direct:read-checkpoint"/>
        <pollEnrich timeout="3000">
            <simple>file:{{kv.store.dir}}?include={{kv.store.file.name}}&amp;noop=true&amp;readLock=none&amp;initialDelay=0</simple>
        </pollEnrich>
        <convertBodyTo type="java.lang.String"/>
        <unmarshal>
            <json library="Jackson"/>
        </unmarshal>
        <setBody>
            <simple>${body[last_date_upd]}</simple>
        </setBody>
    </route>

    <!-- ============================================================= -->
    <!-- Checkpoint yazma: gelen body (yeni tarih) mock K/V store      -->
    <!-- dosyasina JSON olarak yazilir.                                -->
    <!-- ============================================================= -->
    <route id="write-checkpoint-route">
        <onException>
            <exception>java.lang.Exception</exception>
            <handled>
                <constant>true</constant>
            </handled>
            <setProperty name="errorRouteId">
                <simple>${routeId}</simple>
            </setProperty>
            <setProperty name="errorMessage">
                <simple>${exception.message}</simple>
            </setProperty>
            <to uri="direct:handle-integration-error"/>
        </onException>

        <from uri="direct:write-checkpoint"/>
        <setBody>
            <simple>{"last_date_upd": "${body}"}</simple>
        </setBody>
        <setHeader name="CamelFileName">
            <constant>{{kv.store.file.name}}</constant>
        </setHeader>
        <to uri="file:{{kv.store.dir}}"/>
    </route>

    <!-- ============================================================= -->
    <!-- Entegrasyon hatalarini tek noktadan, yapilandirilmis (greppable) -->
    <!-- formatta loglar. "CAMELYNE_INCIDENT" prefix'i sayesinde harici   -->
    <!-- bir log toplayici/alerting sistemi (Loki, ELK, Datadog vb.) bu  -->
    <!-- satirlari yakalayip otomatik ticket acabilir.                  -->
    <!--                                                                -->
    <!-- TODO: Camelyne'in gercek incident/ticket servisi hazir oldugunda -->
    <!-- burada bir HTTP cagrisi eklenecek (Jira/Zendesk/PagerDuty vb.). -->
    <!-- Su an icin sadece structured log uretiyoruz.                  -->
    <!-- ============================================================= -->
    <route id="handle-integration-error-route">
        <from uri="direct:handle-integration-error"/>
        <log loggingLevel="ERROR"
             message="CAMELYNE_INCIDENT integration=customer-sync route=${exchangeProperty.errorRouteId} exchangeId=${exchangeId} error=${exchangeProperty.errorMessage}"/>
    </route>

</routes>
