<!-- DEPS com.camelyne:platform-components:0.2 component="platform-timer,platform-lock,platform-state,platform-queue" -->
<!-- DEPS org.apache.camel:camel-http:4.4.0 component="http" -->
<routes xmlns="http://camel.apache.org/schema/spring">
    <route id="shipment-sync-producer">
        <from uri="platform-timer://odooShipmentNotification?cron=*%2F5%20*%20*%20*%20*&amp;timeZone=UTC"/>
        <log loggingLevel="INFO" message="Odoo shipment notification tick started..."/>
        <!-- 1. Mutex guard via platform-lock: atomic acquire, no get+set race.
                 TTL auto-expires the lock after 10 min in case the worker crashes
                 mid-poll, which is exactly what "is_odoo_shipment_notification_running"
                 needs to never deadlock. -->
        <to uri="platform-lock://odoo-shipment-notification?operation=acquire"/>
        <choice>
            <when>
                <simple>${body} == 'false'</simple>
                <log loggingLevel="INFO" message="Shipment notification is already running, skipping this trigger (could not acquire odoo-shipment-notification lock)"/>
            </when>
            <otherwise>
                <doTry>
                    <!-- 2. Read OUR OWN "last enqueued" watermark (NOT the consumer's
                             "last successfully synced" one) - same two-watermark
                             rationale as order-sync-producer.xml: if the consumer is
                             stopped/lagging and this route fires again before it
                             catches up, we never re-fetch/re-enqueue the same pickings.

                             Watermark is the last ENQUEUED stock.picking id, not a
                             date - same simple "sequential auto-increment" trick as
                             order-sync-producer.xml. Unlike that route, this isn't
                             working around a broken API filter: Odoo's own domain
                             filtering on dates works fine. id is used anyway for
                             consistency/simplicity, with one known tradeoff (see
                             ORDER-DELIVERY-SYNC.md "Bilinen Sinirlamalar" for the
                             legacy route this ports from): if a LOWER-id picking
                             reaches state=done AFTER a HIGHER-id picking already
                             advanced this watermark, the lower-id one is never
                             picked up. Accepted the same way the legacy route
                             accepted it (warehouses generally process older orders
                             first) rather than adding write_date-based complexity
                             upfront. -->
                    <to uri="platform-state://odoo_shipment_notification_last_enqueued_id?operation=get"/>
                    <setHeader name="watermark">
                        <simple>${body}</simple>
                    </setHeader>
                    <setHeader name="minId">
                        <groovy>
                            def w = request.headers['watermark'] as String
                            (w ? (w as long) : 0L) + 1L
                        </groovy>
                    </setHeader>
                    <removeHeaders pattern="*" excludePattern="watermark|minId"/>
                    <!-- normalize the Odoo base URL: strip trailing slashes, add exactly one -->
                    <setHeader name="odooUrl">
                        <simple>{{vars.ODOO_BASE_URL}}</simple>
                    </setHeader>
                    <setHeader name="odooUrl">
                        <groovy>(headers.odooUrl as String).replaceAll('/+$', '') + '/'</groovy>
                    </setHeader>
                    <!-- 3. Search Odoo for outgoing deliveries completed after the
                             watermark, PAGE BY PAGE until a non-full page comes back
                             - same pagination idiom as order-sync-producer.xml, so a
                             backlog bigger than one page is fully drained in THIS
                             tick.

                             sale_id != false is CRITICAL: manual stock transfers not
                             linked to a sale order return Odoo's sale_id as Boolean
                             false, not a [id, name] tuple - without this filter,
                             reading sale_id[0] downstream throws (hit for real in the
                             legacy route-odoo-delivery-poll.xml live test, see
                             ORDER-DELIVERY-SYNC.md).

                             sale_id.client_order_ref =like 'PS-%' filters out sale
                             orders Odoo created outside of PrestaShop entirely
                             (related-field traversal is valid in Odoo search domains,
                             even though it isn't valid in a "fields" list) - =like
                             (not like) because plain "like" auto-wraps the value in
                             %...% for a substring match, we need a literal PREFIX
                             match with the wildcard we supply ourselves. -->
                    <setProperty name="pageSize">
                        <constant>100</constant>
                    </setProperty>
                    <setProperty name="pageOffset">
                        <constant>0</constant>
                    </setProperty>
                    <!-- sentinel so the FIRST loop check (evaluated BEFORE any iteration runs) passes -->
                    <setProperty name="pageFetchedCount">
                        <simple>${exchangeProperty.pageSize}</simple>
                    </setProperty>
                    <!-- tracks the max picking id actually enqueued this tick, across
                         all pages, so we can advance OUR OWN watermark after the loop -->
                    <setProperty name="maxEnqueuedId">
                        <groovy>null</groovy>
                    </setProperty>
                    <loop doWhile="true">
                        <!-- keep paging while the LAST page came back full; a non-full (or
                             empty) page means we reached the end of the backlog -->
                        <simple>${exchangeProperty.pageFetchedCount} == ${exchangeProperty.pageSize}</simple>
                        <setBody>
                            <groovy>
                                [
                                jsonrpc: "2.0",
                                method : "call",
                                params : [
                                service: "object",
                                method : "execute_kw",
                                args   : [
                                "{{vars.ODOO_DB}}",
                                Integer.parseInt("{{vars.ODOO_UID}}"),
                                "{{secrets.ODOO_API_KEY}}",
                                "stock.picking",
                                "search_read",
                                [[
                                ["state", "=", "done"],
                                ["picking_type_code", "=", "outgoing"],
                                ["sale_id", "!=", false],
                                ["sale_id.client_order_ref", "=like", "PS-%"],
                                ["id", ">=", headers.minId as long]
                                ]],
                                ["fields": ["id", "sale_id"], "limit": exchangeProperty.pageSize, "offset": exchangeProperty.pageOffset, "order": "id asc"]
                                ]
                                ]
                                ]
                            </groovy>
                        </setBody>
                        <marshal>
                            <json library="Jackson"/>
                        </marshal>
                        <removeHeaders pattern="CamelHttp*" excludePattern="Content-Type"/>
                        <setHeader name="Content-Type">
                            <constant>application/json</constant>
                        </setHeader>
                        <setHeader name="CamelHttpMethod">
                            <constant>POST</constant>
                        </setHeader>
                        <log loggingLevel="INFO" message="Odoo jsonrpc request (stock.picking.search_read, offset=${exchangeProperty.pageOffset}): ${bodyAs(String)}"/>
                        <toD uri="${header.odooUrl}jsonrpc"/>
                        <log loggingLevel="INFO" message="Odoo jsonrpc response (stock.picking.search_read, offset=${exchangeProperty.pageOffset}): ${body}"/>
                        <unmarshal>
                            <json library="Jackson"/>
                        </unmarshal>
                        <setBody>
                            <groovy>
                                // Odoo's jsonrpc envelope is always {"result": [...]} -
                                // unlike PrestaShop's Webservice, there's no bare-array-
                                // vs-wrapped-object ambiguity to normalize here.
                                def raw = (body as Map)?.result
                                def res = raw == null ? [] : (raw instanceof List ? raw : [raw])
                                // Belt-and-braces: guarantee strict ordering even if the API's "order" were ignored
                                res.sort { (it.id as long) }
                            </groovy>
                        </setBody>
                        <setProperty name="pageFetchedCount">
                            <simple>${body.size()}</simple>
                        </setProperty>
                        <!-- body is sorted ascending by id, so its last element
                             (if any) holds this page's max id -->
                        <setProperty name="maxEnqueuedId">
                            <groovy>
                                def pageMax = (body as List) ? (body[-1]?.id as Long) : null
                                def currentMax = exchangeProperty.maxEnqueuedId as Long
                                (pageMax != null &amp;&amp; (currentMax == null || pageMax > currentMax)) ? pageMax : currentMax
                            </groovy>
                        </setProperty>
                        <choice>
                            <when>
                                <simple>${exchangeProperty.pageFetchedCount} == 0</simple>
                                <log loggingLevel="INFO" message="No new completed Odoo deliveries found (offset=${exchangeProperty.pageOffset}, minId=${header.minId})"/>
                            </when>
                            <otherwise>
                                <log loggingLevel="INFO" message="Fetched ${exchangeProperty.pageFetchedCount} completed Odoo delivery/deliveries (offset=${exchangeProperty.pageOffset})"/>
                            </otherwise>
                        </choice>
                        <split>
                            <simple>${body}</simple>
                            <!-- Payload Structure: picking id + the sale.order id already
                                 known from this search (sale_id is a [id, name] tuple) -
                                 the consumer re-reads the sale order live itself for
                                 client_order_ref, so this is never stale. -->
                            <setBody>
                                <groovy>
                                    [
                                    id         : body['id'],
                                    saleOrderId: (body['sale_id'] as List)[0]
                                    ]
                                </groovy>
                            </setBody>
                            <marshal>
                                <json library="Jackson"/>
                            </marshal>
                            <log loggingLevel="INFO" message="Enqueueing Odoo delivery ${body}"/>
                            <to uri="platform-queue://odoo-prestashop-shipment-notification-queue"/>
                        </split>
                        <setProperty name="pageOffset">
                            <groovy>(exchangeProperty.pageOffset as int) + (exchangeProperty.pageSize as int)</groovy>
                        </setProperty>
                    </loop>
                    <choice>
                        <when>
                            <simple>${exchangeProperty.maxEnqueuedId} != null</simple>
                            <!-- 3b. Advance OUR OWN "last enqueued" watermark (plain
                                     picking id, same storage key convention as the
                                     consumer's success-watermark) so a producer run
                                     that fires again before the consumer catches up
                                     never re-fetches/re-enqueues what's already
                                     queued. -->
                            <setBody>
                                <simple>${exchangeProperty.maxEnqueuedId}</simple>
                            </setBody>
                            <to uri="platform-state://odoo_shipment_notification_last_enqueued_id?operation=put"/>
                        </when>
                    </choice>
                    <doCatch>
                        <exception>org.apache.camel.http.base.HttpOperationFailedException</exception>
                        <log loggingLevel="ERROR" message="Odoo shipment notification: source API returned an error. status=${exception.statusCode} url=${exception.uri} body=${exception.responseBody}"/>
                    </doCatch>
                    <doCatch>
                        <exception>java.lang.Exception</exception>
                        <log loggingLevel="ERROR" message="Odoo shipment notification polling failed: ${exception.message}"/>
                    </doCatch>
                    <doFinally>
                        <!-- 4. Always release the lock / reset is_odoo_shipment_notification_running, success or failure -->
                        <to uri="platform-lock://odoo-shipment-notification?operation=release"/>
                    </doFinally>
                </doTry>
            </otherwise>
        </choice>
    </route>
</routes>
