<!-- DEPS com.camelyne:platform-components:0.2 component="platform-queue,platform-state" -->
<!-- DEPS org.apache.camel:camel-http:4.4.0 component="http" -->
<!-- DEPS org.apache.camel:camel-base64:4.18.4 -->
<routes xmlns="http://camel.apache.org/schema/spring">
    <route id="order-sync-consumer">
        <from uri="platform-queue://prestashop-odoo-order-injection-queue?mode=pull"/>

        <onException>
            <exception>java.lang.Exception</exception>
            <redeliveryPolicy maximumRedeliveries="3" redeliveryDelay="1000" backOffMultiplier="2" useExponentialBackOff="true"/>
            <handled>
                <constant>true</constant>
            </handled>
            <log loggingLevel="ERROR" message="Order injection consumer failed after retries, sending to DLQ: ${exception.message}"/>
            <setBody>
                <simple>${exchangeProperty.rawJson}</simple>
            </setBody>
            <to uri="platform-queue://prestashop-odoo-order-injection-dlq"/>
        </onException>

        <log loggingLevel="INFO" message="Order injection consumer received: ${body}"/>
        <!-- keep the raw message around so we can push it, unchanged, to the DLQ on failure -->
        <setProperty name="rawJson">
            <simple>${body}</simple>
        </setProperty>
        <unmarshal>
            <json library="Jackson"/>
        </unmarshal>
        <setProperty name="queueRef">
            <simple>${body}</simple>
        </setProperty>

        <!-- normalize base URLs the same way the producer does -->
        <setHeader name="odooUrl">
            <simple>{{vars.ODOO_BASE_URL}}</simple>
        </setHeader>
        <setHeader name="odooUrl">
            <groovy>(headers.odooUrl as String).replaceAll('/+$', '') + '/'</groovy>
        </setHeader>
        <setHeader name="prestaUrl">
            <simple>{{vars.PRESTA_BASE_URL}}</simple>
        </setHeader>
        <setHeader name="prestaUrl">
            <groovy>(headers.prestaUrl as String).replaceAll('/+$', '') + '/'</groovy>
        </setHeader>

        <!-- PrestaShop Webservice auth: API key as Basic auth username, empty password -->
        <setHeader name="Authorization">
            <simple>Basic ${base64Encode({{secrets.PRESTA_API_KEY}}:)}</simple>
        </setHeader>

        <!-- 1. Idempotency FIRST: if this PrestaShop order was already injected
                 (client_order_ref = "PS-<reference>"), skip creation entirely and treat
                 as success - no duplicate sale.order, no DLQ, even if this queue item
                 is a re-delivery. Uses PrestaShop's human-readable order "reference"
                 (e.g. "OQXTEKJMS") rather than the raw numeric id - it's the code
                 customers/staff actually see, so it doubles as a meaningful Odoo order
                 number. Falls back to the numeric id if reference is ever missing
                 (e.g. a queue item enqueued before this field existed). -->
        <setProperty name="prestashopOrderRef">
            <groovy>
                def q = exchangeProperty.queueRef as Map
                def ref = q.reference as String
                "PS-" + ((ref != null &amp;&amp; !ref.trim().isEmpty()) ? ref : q.id)
            </groovy>
        </setProperty>
        <setBody>
            <groovy>
                [
                jsonrpc: "2.0",
                method : "call",
                params : [
                service: "object",
                method : "execute_kw",
                args   : [
                "{{vars.ODOO_DB}}",
                Integer.parseInt("{{vars.ODOO_UID}}"),
                "{{secrets.ODOO_API_KEY}}",
                "sale.order",
                "search_read",
                [[["client_order_ref", "=", exchangeProperty.prestashopOrderRef]]],
                ["fields": ["id"], "limit": 1]
                ]
                ]
                ]
            </groovy>
        </setBody>
        <marshal>
            <json library="Jackson"/>
        </marshal>
        <removeHeaders pattern="CamelHttp*" excludePattern="Authorization"/>
        <setHeader name="Content-Type">
            <constant>application/json</constant>
        </setHeader>
        <setHeader name="CamelHttpMethod">
            <constant>POST</constant>
        </setHeader>
        <log loggingLevel="INFO" message="Odoo jsonrpc request (sale.order.search_read client_order_ref): ${bodyAs(String)}"/>
        <toD uri="${header.odooUrl}jsonrpc"/>
        <unmarshal>
            <json library="Jackson"/>
        </unmarshal>
        <setProperty name="existingOdooOrderId">
            <groovy>
                def res = (body as Map)?.result ?: []
                res.size() > 0 ? res[0].id : null
            </groovy>
        </setProperty>

        <choice>
            <when>
                <simple>${exchangeProperty.existingOdooOrderId} != null</simple>
                <log loggingLevel="INFO" message="PrestaShop order ${exchangeProperty.prestashopOrderRef} already injected as Odoo sale.order id=${exchangeProperty.existingOdooOrderId}, skipping (idempotent)"/>
            </when>
            <otherwise>
                <!-- 2. Fetch the FULL order from PrestaShop (order lines + shipping/discount totals) -->
                <removeHeaders pattern="CamelHttp*" excludePattern="Authorization"/>
                <toD uri="${exchangeProperty.queueRef[url]}?output_format=JSON"/>
                <unmarshal>
                    <json library="Jackson"/>
                </unmarshal>
                <setProperty name="prestaOrder">
                    <simple>${body[order]}</simple>
                </setProperty>
                <log loggingLevel="INFO" message="Fetched PrestaShop order: ${exchangeProperty.prestaOrder}"/>

                <!-- 3. Fetch the customer (email isn't present on the order resource itself) -->
                <setHeader name="PrestashopCustomerId">
                    <simple>${exchangeProperty.prestaOrder[id_customer]}</simple>
                </setHeader>
                <removeHeaders pattern="CamelHttp*" excludePattern="Authorization"/>
                <toD uri="${header.prestaUrl}api/customers/${header.PrestashopCustomerId}?output_format=JSON"/>
                <unmarshal>
                    <json library="Jackson"/>
                </unmarshal>
                <setProperty name="prestaCustomer">
                    <simple>${body[customer]}</simple>
                </setProperty>

                <!-- 4. Odoo: find-or-create the customer (res.partner), by email -->
                <setBody>
                    <groovy>
                        def c = exchangeProperty.prestaCustomer as Map
                        [
                        jsonrpc: "2.0",
                        method : "call",
                        params : [
                        service: "object",
                        method : "execute_kw",
                        args   : [
                        "{{vars.ODOO_DB}}",
                        Integer.parseInt("{{vars.ODOO_UID}}"),
                        "{{secrets.ODOO_API_KEY}}",
                        "res.partner",
                        "search_read",
                        [[["email", "=", c.email]]],
                        ["fields": ["id"], "limit": 1]
                        ]
                        ]
                        ]
                    </groovy>
                </setBody>
                <marshal>
                    <json library="Jackson"/>
                </marshal>
                <removeHeaders pattern="CamelHttp*" excludePattern="Authorization"/>
                <setHeader name="Content-Type">
                    <constant>application/json</constant>
                </setHeader>
                <setHeader name="CamelHttpMethod">
                    <constant>POST</constant>
                </setHeader>
                <log loggingLevel="INFO" message="Odoo jsonrpc request (res.partner.search_read email): ${bodyAs(String)}"/>
                <toD uri="${header.odooUrl}jsonrpc"/>
                <unmarshal>
                    <json library="Jackson"/>
                </unmarshal>
                <setProperty name="odooPartnerId">
                    <groovy>
                        def res = (body as Map)?.result ?: []
                        res.size() > 0 ? res[0].id : null
                    </groovy>
                </setProperty>

                <choice>
                    <when>
                        <simple>${exchangeProperty.odooPartnerId} == null</simple>
                        <setBody>
                            <groovy>
                                def c = exchangeProperty.prestaCustomer as Map
                                [
                                jsonrpc: "2.0",
                                method : "call",
                                params : [
                                service: "object",
                                method : "execute_kw",
                                args   : [
                                "{{vars.ODOO_DB}}",
                                Integer.parseInt("{{vars.ODOO_UID}}"),
                                "{{secrets.ODOO_API_KEY}}",
                                "res.partner",
                                "create",
                                [[
                                "name"         : ((c.firstname ?: '') + ' ' + (c.lastname ?: '')).trim(),
                                "email"        : c.email,
                                "company_type" : "person",
                                "customer_rank": 1
                                ]]
                                ]
                                ]
                                ]
                            </groovy>
                        </setBody>
                        <marshal>
                            <json library="Jackson"/>
                        </marshal>
                        <removeHeaders pattern="CamelHttp*" excludePattern="Authorization"/>
                        <setHeader name="Content-Type">
                            <constant>application/json</constant>
                        </setHeader>
                        <setHeader name="CamelHttpMethod">
                            <constant>POST</constant>
                        </setHeader>
                        <log loggingLevel="INFO" message="Odoo jsonrpc request (res.partner.create): ${bodyAs(String)}"/>
                        <toD uri="${header.odooUrl}jsonrpc"/>
                        <unmarshal>
                            <json library="Jackson"/>
                        </unmarshal>
                        <setProperty name="odooPartnerId">
                            <simple>${body[result]}</simple>
                        </setProperty>
                        <log loggingLevel="INFO" message="Yeni Odoo musterisi olusturuldu: email=${exchangeProperty.prestaCustomer[email]} id=${exchangeProperty.odooPartnerId}"/>
                    </when>
                    <otherwise>
                        <log loggingLevel="INFO" message="Odoo musterisi bulundu: email=${exchangeProperty.prestaCustomer[email]} id=${exchangeProperty.odooPartnerId}"/>
                    </otherwise>
                </choice>

                <!-- 5. Odoo: create the sale.order. client_order_ref is our idempotency key. -->
                <setBody>
                    <groovy>
                        [
                        jsonrpc: "2.0",
                        method : "call",
                        params : [
                        service: "object",
                        method : "execute_kw",
                        args   : [
                        "{{vars.ODOO_DB}}",
                        Integer.parseInt("{{vars.ODOO_UID}}"),
                        "{{secrets.ODOO_API_KEY}}",
                        "sale.order",
                        "create",
                        [[
                        "partner_id"      : exchangeProperty.odooPartnerId,
                        "client_order_ref": exchangeProperty.prestashopOrderRef,
                        "origin"          : "PrestaShop Order Injection"
                        ]]
                        ]
                        ]
                        ]
                    </groovy>
                </setBody>
                <marshal>
                    <json library="Jackson"/>
                </marshal>
                <removeHeaders pattern="CamelHttp*" excludePattern="Authorization"/>
                <setHeader name="Content-Type">
                    <constant>application/json</constant>
                </setHeader>
                <setHeader name="CamelHttpMethod">
                    <constant>POST</constant>
                </setHeader>
                <log loggingLevel="INFO" message="Odoo jsonrpc request (sale.order.create): ${bodyAs(String)}"/>
                <toD uri="${header.odooUrl}jsonrpc"/>
                <unmarshal>
                    <json library="Jackson"/>
                </unmarshal>
                <setProperty name="odooOrderId">
                    <simple>${body[result]}</simple>
                </setProperty>
                <log loggingLevel="INFO" message="Odoo satis siparisi (taslak) olusturuldu: id=${exchangeProperty.odooOrderId} client_order_ref=${exchangeProperty.prestashopOrderRef}"/>

                <!-- 6. Odoo: one sale.order.line per PrestaShop order row. Unknown SKU
                             throws -> onException -> DLQ (this order only; the rest of
                             the queue is unaffected). -->
                <split stopOnException="true">
                    <simple>${exchangeProperty.prestaOrder[associations][order_rows]}</simple>
                    <setHeader name="ProductSku">
                        <simple>${body[product_reference]}</simple>
                    </setHeader>
                    <setHeader name="LineQty">
                        <simple>${body[product_quantity]}</simple>
                    </setHeader>
                    <setHeader name="LinePrice">
                        <simple>${body[unit_price_tax_excl]}</simple>
                    </setHeader>
                    <to uri="direct:order-injection-findOdooProductBySku"/>
                    <choice>
                        <when>
                            <simple>${header.OdooProductId} == null</simple>
                            <throwException exceptionType="java.lang.IllegalStateException"
                                            message="Odoo urunu bulunamadi (product_tmpl_id/default_code eslesmedi): SKU=${header.ProductSku}, prestashopOrderRef=${exchangeProperty.prestashopOrderRef}, odooOrderId=${exchangeProperty.odooOrderId}"/>
                        </when>
                    </choice>
                    <to uri="direct:order-injection-createOdooSaleOrderLine"/>
                </split>

                <!-- 7. Shipping / discount -> Odoo "service product" lines. These SKUs
                             are PLACEHOLDERS (vars.ODOO_SHIPPING_PRODUCT_SKU /
                             vars.ODOO_DISCOUNT_PRODUCT_SKU) until the real service
                             products exist in Odoo - until then the line is skipped
                             with a WARN log rather than failing the whole order. -->
                <choice>
                    <when>
                        <simple>${exchangeProperty.prestaOrder[total_shipping_tax_excl]} > 0</simple>
                        <setHeader name="ProductSku">
                            <simple>{{vars.ODOO_SHIPPING_PRODUCT_SKU}}</simple>
                        </setHeader>
                        <setHeader name="LineQty">
                            <constant>1</constant>
                        </setHeader>
                        <setHeader name="LinePrice">
                            <simple>${exchangeProperty.prestaOrder[total_shipping_tax_excl]}</simple>
                        </setHeader>
                        <to uri="direct:order-injection-findOdooProductBySku"/>
                        <choice>
                            <when>
                                <simple>${header.OdooProductId} == null</simple>
                                <log loggingLevel="WARN" message="Kargo urunu (SKU={{vars.ODOO_SHIPPING_PRODUCT_SKU}}) Odoo'da bulunamadi, kargo satiri atlandi: odooOrderId=${exchangeProperty.odooOrderId}"/>
                            </when>
                            <otherwise>
                                <to uri="direct:order-injection-createOdooSaleOrderLine"/>
                            </otherwise>
                        </choice>
                    </when>
                </choice>
                <choice>
                    <when>
                        <simple>${exchangeProperty.prestaOrder[total_discounts_tax_excl]} > 0</simple>
                        <setHeader name="ProductSku">
                            <simple>{{vars.ODOO_DISCOUNT_PRODUCT_SKU}}</simple>
                        </setHeader>
                        <setHeader name="LineQty">
                            <constant>1</constant>
                        </setHeader>
                        <setHeader name="LinePrice">
                            <groovy>-(exchangeProperty.prestaOrder['total_discounts_tax_excl'] as BigDecimal)</groovy>
                        </setHeader>
                        <to uri="direct:order-injection-findOdooProductBySku"/>
                        <choice>
                            <when>
                                <simple>${header.OdooProductId} == null</simple>
                                <log loggingLevel="WARN" message="Indirim urunu (SKU={{vars.ODOO_DISCOUNT_PRODUCT_SKU}}) Odoo'da bulunamadi, indirim satiri atlandi: odooOrderId=${exchangeProperty.odooOrderId}"/>
                            </when>
                            <otherwise>
                                <to uri="direct:order-injection-createOdooSaleOrderLine"/>
                            </otherwise>
                        </choice>
                    </when>
                </choice>

                <!-- 8. Confirm the order -->
                <setBody>
                    <groovy>
                        [
                        jsonrpc: "2.0",
                        method : "call",
                        params : [
                        service: "object",
                        method : "execute_kw",
                        args   : [
                        "{{vars.ODOO_DB}}",
                        Integer.parseInt("{{vars.ODOO_UID}}"),
                        "{{secrets.ODOO_API_KEY}}",
                        "sale.order",
                        "action_confirm",
                        [[exchangeProperty.odooOrderId]]
                        ]
                        ]
                        ]
                    </groovy>
                </setBody>
                <marshal>
                    <json library="Jackson"/>
                </marshal>
                <removeHeaders pattern="CamelHttp*" excludePattern="Authorization"/>
                <setHeader name="Content-Type">
                    <constant>application/json</constant>
                </setHeader>
                <setHeader name="CamelHttpMethod">
                    <constant>POST</constant>
                </setHeader>
                <log loggingLevel="INFO" message="Odoo jsonrpc request (sale.order.action_confirm): ${bodyAs(String)}"/>
                <toD uri="${header.odooUrl}jsonrpc"/>
                <!-- convertBodyTo: bu cagridan sonra unmarshal YOK, o yuzden body
                     InputStreamCache olarak kalirdi ve debug/log ciktisinda
                     "InputStreamCache@..." gibi okunmaz gorunurdu. -->
                <convertBodyTo type="java.lang.String"/>
                <log loggingLevel="INFO" message="Odoo jsonrpc response (sale.order.action_confirm): ${body}"/>
                <log loggingLevel="INFO" message="Odoo siparisi onaylandi (action_confirm): odooOrderId=${exchangeProperty.odooOrderId}"/>

                <!-- 9. Write the status back to PrestaShop (e.g. "Processing") so the
                             store team sees the order moved on. Same target endpoint as
                             the legacy order-sync route's order-history XSLT pipeline
                             (templates/prestashop/order-history-source.xml +
                             xslt/prestashop-order-history.xslt), just inlined here since
                             it's only two fields. -->
                <setBody>
                    <simple>&lt;prestashop xmlns:xlink="http://www.w3.org/1999/xlink"&gt;&lt;order_history&gt;&lt;id_order&gt;${exchangeProperty.queueRef[id]}&lt;/id_order&gt;&lt;id_order_state&gt;{{vars.PRESTA_ORDER_STATE_PROCESSING}}&lt;/id_order_state&gt;&lt;/order_history&gt;&lt;/prestashop&gt;</simple>
                </setBody>
                <removeHeaders pattern="CamelHttp*" excludePattern="Authorization"/>
                <setHeader name="Content-Type">
                    <constant>text/xml</constant>
                </setHeader>
                <setHeader name="CamelHttpMethod">
                    <constant>POST</constant>
                </setHeader>
                <toD uri="${header.prestaUrl}api/order_histories"/>
                <convertBodyTo type="java.lang.String"/>
                <log loggingLevel="INFO" message="PrestaShop order_histories response: ${body}"/>
                <log loggingLevel="INFO" message="PrestaShop order_histories guncellendi: orderId=${exchangeProperty.queueRef[id]} newStateId={{vars.PRESTA_ORDER_STATE_PROCESSING}}"/>

                <!-- 10. Advance OUR OWN "last successfully synced" watermark, using
                              this item's own PrestaShop order id (producer enqueues in
                              ascending id order, since id filtering replaced the
                              unreliable invoice_date/date_upd filter - see
                              order-sync-producer.xml) - same two-watermark design as
                              product-sync-consumer.xml. -->
                <setBody>
                    <simple>${exchangeProperty.queueRef[id]}</simple>
                </setBody>
                <to uri="platform-state://prestashop_order_injection_last_successful_id?operation=put"/>
            </otherwise>
        </choice>
    </route>

    <!-- Yardimci alt-route'lar: urun arama ve sale.order.line olusturma -
         normal urun satirlari, kargo ve indirim satirlari icin ayni iki adim
         tekrar kullanilir (DRY). Legacy
         route-odoo-order.xml:odoo-findProductBySku/odoo-createSaleOrderLine'in
         execute_kw karsiligi. -->
    <route id="order-injection-findOdooProductBySku">
        <from uri="direct:order-injection-findOdooProductBySku"/>
        <!-- product-sync-consumer.xml urunleri PrestaShop'a reference="ODOO-<product.template id>"
             ile yaziyor (bkz. product-sync-consumer.xml:113) - bu yuzden
             PrestaShop siparis satirlarindaki product_reference bir default_code
             DEGIL, Odoo product.template id'si. sale.order.line.product_id ise
             product.product (varyant) id'si bekler, product.template id'si
             DEGIL - o yuzden product_tmpl_id uzerinden product.product'i buluyoruz.
             Kargo/indirim gibi ODOO- onekli OLMAYAN SKU'lar (vars.ODOO_SHIPPING_PRODUCT_SKU/
             vars.ODOO_DISCOUNT_PRODUCT_SKU) icin ise normal default_code aramasina
             dusulur. -->
        <setBody>
            <groovy>
                def sku = headers.ProductSku as String
                def m = (sku =~ /^ODOO-(\d+)$/)
                def domain = m.matches() ? [["product_tmpl_id", "=", m.group(1) as Integer]] : [["default_code", "=", sku]]
                [
                jsonrpc: "2.0",
                method : "call",
                params : [
                service: "object",
                method : "execute_kw",
                args   : [
                "{{vars.ODOO_DB}}",
                Integer.parseInt("{{vars.ODOO_UID}}"),
                "{{secrets.ODOO_API_KEY}}",
                "product.product",
                "search_read",
                [domain],
                ["fields": ["id"], "limit": 1]
                ]
                ]
                ]
            </groovy>
        </setBody>
        <marshal>
            <json library="Jackson"/>
        </marshal>
        <removeHeaders pattern="CamelHttp*" excludePattern="Authorization"/>
        <setHeader name="Content-Type">
            <constant>application/json</constant>
        </setHeader>
        <setHeader name="CamelHttpMethod">
            <constant>POST</constant>
        </setHeader>
        <log loggingLevel="INFO" message="Odoo jsonrpc request (product.product.search_read): ${bodyAs(String)}"/>
        <toD uri="${header.odooUrl}jsonrpc"/>
        <unmarshal>
            <json library="Jackson"/>
        </unmarshal>
        <choice>
            <when>
                <simple>${body[result].size()} &gt; 0</simple>
                <setHeader name="OdooProductId">
                    <simple>${body[result][0][id]}</simple>
                </setHeader>
            </when>
        </choice>
    </route>

    <route id="order-injection-createOdooSaleOrderLine">
        <from uri="direct:order-injection-createOdooSaleOrderLine"/>
        <setBody>
            <groovy>
                [
                jsonrpc: "2.0",
                method : "call",
                params : [
                service: "object",
                method : "execute_kw",
                args   : [
                "{{vars.ODOO_DB}}",
                Integer.parseInt("{{vars.ODOO_UID}}"),
                "{{secrets.ODOO_API_KEY}}",
                "sale.order.line",
                "create",
                [[
                "order_id"       : exchangeProperty.odooOrderId,
                "product_id"     : headers.OdooProductId,
                "product_uom_qty": headers.LineQty,
                "price_unit"     : headers.LinePrice
                ]]
                ]
                ]
                ]
            </groovy>
        </setBody>
        <marshal>
            <json library="Jackson"/>
        </marshal>
        <removeHeaders pattern="CamelHttp*" excludePattern="Authorization"/>
        <setHeader name="Content-Type">
            <constant>application/json</constant>
        </setHeader>
        <setHeader name="CamelHttpMethod">
            <constant>POST</constant>
        </setHeader>
        <log loggingLevel="INFO" message="Odoo jsonrpc request (sale.order.line.create): ${bodyAs(String)}"/>
        <toD uri="${header.odooUrl}jsonrpc"/>
        <convertBodyTo type="java.lang.String"/>
        <log loggingLevel="INFO" message="Odoo jsonrpc response (sale.order.line.create): ${body}"/>
        <log loggingLevel="INFO" message="Siparis satiri eklendi: odooOrderId=${exchangeProperty.odooOrderId} SKU=${header.ProductSku} qty=${header.LineQty}"/>
    </route>
</routes>
