<!-- DEPS com.camelyne:platform-components:0.2 component="platform-queue,platform-state" --><!-- DEPS org.apache.camel:camel-http:4.4.0 component="http" --><routes xmlns="http://camel.apache.org/schema/spring">
  <!--
      Customer Sync - Consumer (push-based queue -> Odoo upsert)
      ============================================================
      Reads ONE customer record at a time from "customers-sync-queue"
      (pushed there, in strict date_upd order, by customer-sync-producer.xml),
      transforms it from PrestaShop's "customer" shape into an Odoo
      res.partner "vals" map, then upserts it into Odoo via JSON-RPC
      (search_read by ref, then write or create).

      Resource wiring (to be done by the user in the Designer):
        - This route's `from` must be bound to the PUSH-BASED QUEUE
          resource that receives the producer's messages
          (queue code assumed: "customers-sync-queue" - adjust the
          URI below if the resource's code differs).
        - A second queue resource "customers-sync-dlq" is expected to
          exist for records that fail after retries/transform errors,
          so a bad record never blocks the rest of the queue.

      Odoo connection (define under the integration's Variables/Secrets
      tabs - never hardcode):
        - vars.ODOO_URL     e.g. https://my-odoo.example.com/  (JSON-RPC
                            endpoint "jsonrpc" is appended below)
        - vars.ODOO_DB      Odoo database name
        - vars.ODOO_UID     numeric uid of the API/service user
                            (obtained once via common/login - this
                            route assumes it is already known and
                            stored as a variable; add a login call
                            here instead if you prefer not to hardcode it)
        - secrets.ODOO_API_KEY  Odoo API key / password for that uid

      Upsert key: PrestaShop's numeric customer id is written into
      Odoo's res.partner.ref as "PRESTA-<id>" and used to look the
      record up before deciding write vs create. Change this mapping
      if you'd rather upsert on email.

      Watermark: after a successful upsert, this route advances the
      shared platform-state key "last_successful_sync_timestamp" to
      this record's date_upd (converted to UTC ISO-8601), exactly as
      called out in customer-sync-producer.xml's comments. Because the
      producer enqueues strictly in ascending date_upd order, advancing
      the watermark per successfully processed record is safe.
    -->
  <route id="customer-sync-consumer">
    <from uri="platform-queue://customers-sync-queue?mode=pull"/>
    <log loggingLevel="INFO" message="Customer sync consumer received: ${body}"/>
    <!-- keep the raw message around so we can push it, unchanged, to the DLQ on failure -->
    <setProperty name="rawJson">
      <simple>${body}</simple>
    </setProperty>
    <unmarshal>
      <json library="Jackson"/>
    </unmarshal>
    <setProperty name="prestaCustomer">
      <simple>${body}</simple>
    </setProperty>
    <doTry>
      <!-- 1. Transform: PrestaShop customer fields -> Odoo res.partner vals -->
      <setBody>
        <groovy>
                    def p = exchangeProperty.prestaCustomer as Map
                    def firstname = (p.firstname ?: '').toString().trim()
                    def lastname = (p.lastname ?: '').toString().trim()
                    def fullName = [firstname, lastname].findAll { it }.join(' ')
                    def vals = [
                        ref         : "PRESTA-${p.id}".toString(),
                        name        : fullName ?: (p.email ?: "PRESTA-${p.id}".toString()),
                        email       : p.email ?: null,
                        website     : p.website ?: null,
                        comment     : p.note ?: null,
                        company_name: (p.company ?: null),
                        is_company  : (p.company ? true : false),
                        active      : (p.active == '1')
                    ]
                    // Odoo's ORM wants `false`, not JSON null, for "no value"
                    vals.collectEntries { k, v -&gt; [k, (v == null ? false : v)] }
                </groovy>
      </setBody>
      <setProperty name="odooPartner">
        <simple>${body}</simple>
      </setProperty>
      <log loggingLevel="INFO" message="Transformed Odoo partner vals: ${body}"/>
      <!-- normalize the Odoo base URL the same way the producer normalizes PRESTA_BASE_URL -->
      <setHeader name="odooUrl">
        <simple>{{vars.ODOO_BASE_URL}}</simple>
      </setHeader>
      <setHeader name="odooUrl">
        <groovy>(headers.odooUrl as String).replaceAll('/+$', '') + '/'</groovy>
      </setHeader>
      <!-- 2. Look the partner up by ref, to decide create vs write -->
      <setBody>
        <groovy>
                    def partner = exchangeProperty.odooPartner as Map
                    [
                        jsonrpc: "2.0",
                        method : "call",
                        params : [
                            service: "object",
                            method : "execute_kw",
                            args   : [
                                "{{vars.ODOO_DB}}",
                                Integer.parseInt("{{vars.ODOO_UID}}"),
                                "{{secrets.ODOO_API_KEY}}",
                                "res.partner",
                                "search_read",
                                [[["ref", "=", partner.ref]]],
                                ["fields": ["id"]]
                            ]
                        ]
                    ]
                </groovy>
      </setBody>
      <marshal>
        <json library="Jackson"/>
      </marshal>
      <removeHeaders pattern="CamelHttp*"/>
      <setHeader name="Content-Type">
        <constant>application/json</constant>
      </setHeader>
      <setHeader name="CamelHttpMethod">
        <constant>POST</constant>
      </setHeader>
      <toD uri="${header.odooUrl}jsonrpc"/>
            <log loggingLevel="INFO" message="Invoked Odoo API : ${body}"/>
      <unmarshal>
        <json library="Jackson"/>
      </unmarshal>
      <setProperty name="odooExistingId">
        <groovy>
                    def res = (body as Map)?.result
                    (res &amp;&amp; res.size() &gt; 0) ? res[0].id : null
                </groovy>
      </setProperty>
      <!-- 3. Upsert: write if found, create otherwise -->
      <choice>
        <when>
          <simple>${exchangeProperty.odooExistingId} != null</simple>
          <setBody>
            <groovy>
                            def partner = exchangeProperty.odooPartner as Map
                            def id = exchangeProperty.odooExistingId
                            [
                                jsonrpc: "2.0",
                                method : "call",
                                params : [
                                    service: "object",
                                    method : "execute_kw",
                                    args   : [
                                        "{{vars.ODOO_DB}}",
                                        Integer.parseInt("{{vars.ODOO_UID}}"),
                                        "{{secrets.ODOO_API_KEY}}",
                                        "res.partner",
                                        "write",
                                        [[id], partner]
                                    ]
                                ]
                            ]
                        </groovy>
          </setBody>
          <log loggingLevel="INFO" message="Updating Odoo res.partner id=${exchangeProperty.odooExistingId} (ref=${exchangeProperty.odooPartner[ref]})"/>
        </when>
        <otherwise>
          <setBody>
            <groovy>
                            def partner = exchangeProperty.odooPartner as Map
                            [
                                jsonrpc: "2.0",
                                method : "call",
                                params : [
                                    service: "object",
                                    method : "execute_kw",
                                    args   : [
                                        "{{vars.ODOO_DB}}",
                                        Integer.parseInt("{{vars.ODOO_UID}}"),
                                        "{{secrets.ODOO_API_KEY}}",
                                        "res.partner",
                                        "create",
                                        [partner]
                                    ]
                                ]
                            ]
                        </groovy>
          </setBody>
          <log loggingLevel="INFO" message="Creating new Odoo res.partner (ref=${exchangeProperty.odooPartner[ref]})"/>
        </otherwise>
      </choice>
      <marshal>
        <json library="Jackson"/>
      </marshal>
      <removeHeaders pattern="CamelHttp*"/>
      <setHeader name="Content-Type">
        <constant>application/json</constant>
      </setHeader>
      <setHeader name="CamelHttpMethod">
        <constant>POST</constant>
      </setHeader>
      <toD uri="${header.odooUrl}jsonrpc"/>
      <unmarshal>
        <json library="Jackson"/>
      </unmarshal>
      <!-- Odoo's JSON-RPC returns HTTP 200 even on failure, the error is INSIDE the body -->
      <choice>
        <when>
          <simple>${body[error]} != null</simple>
          <throwException exceptionType="java.lang.RuntimeException" message="${body[error][data][message]}"/>
        </when>
      </choice>
      <log loggingLevel="INFO" message="Odoo upsert OK, result=${body}"/>
      <!-- 4. Advance the shared watermark to this record's date_upd (producer enqueues in ascending order) -->
      <setBody>
        <groovy>
                    def p = exchangeProperty.prestaCustomer as Map
                    java.time.LocalDateTime.parse(p.date_upd as String, java.time.format.DateTimeFormatter.ofPattern('yyyy-MM-dd HH:mm:ss'))
                        .atOffset(java.time.ZoneOffset.UTC)
                        .format(java.time.format.DateTimeFormatter.ISO_OFFSET_DATE_TIME)
                </groovy>
      </setBody>
      <to uri="platform-state://last_successful_sync_timestamp?operation=put"/>
      <doCatch>
        <exception>java.lang.Exception</exception>
        <log loggingLevel="ERROR" message="Customer sync consumer failed for record, sending to DLQ: ${exception.message}"/>
        <setBody>
          <simple>${exchangeProperty.rawJson}</simple>
        </setBody>
        <to uri="platform-queue://customers-sync-dlq"/>
      </doCatch>
    </doTry>
  </route>
  
</routes>