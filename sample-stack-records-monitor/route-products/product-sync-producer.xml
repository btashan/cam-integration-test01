<!-- DEPS com.camelyne:platform-components:0.2 component="platform-timer,platform-lock,platform-state,platform-queue" -->
<!-- DEPS org.apache.camel:camel-http:4.4.0 component="http" -->
<routes xmlns="http://camel.apache.org/schema/spring">
    <route id="product-sync-producer">
        <from uri="platform-timer://odooProductSync?cron=0%2010%20*%20*%20*&amp;timeZone=UTC"/>
        <log loggingLevel="INFO" message="Odoo product sync tick started..."/>
        <!-- 1. Mutex guard via platform-lock: atomic acquire, no get+set race.
                 TTL auto-expires the lock after 10 min in case the worker crashes
                 mid-poll, which is exactly what "is_odoo_product_sync_running"
                 needs to never deadlock. -->
        <to uri="platform-lock://odoo-product-sync?operation=acquire"/>
        <choice>
            <when>
                <simple>${body} == 'false'</simple>
                <log loggingLevel="INFO" message="Product sync is already running, skipping this trigger (could not acquire odoo-product-sync lock)"/>
            </when>
            <otherwise>
                <doTry>
                    <!-- 2. Read OUR OWN "last enqueued" watermark (NOT the consumer's
                             "last successfully synced" one) and build the Odoo domain
                             filter. Using our own watermark means that if the consumer
                             is stopped/lagging and this route fires again before it
                             catches up, we never re-fetch/re-enqueue the same records -
                             duplicate enqueues are avoided regardless of consumer state.
                             Items that fail downstream still go through the consumer's
                             own retry/DLQ path, independent of this watermark. -->
                    <to uri="platform-state://product_sync_last_enqueued_timestamp?operation=get"/>
                    <setHeader name="watermark">
                        <simple>${body}</simple>
                    </setHeader>
                    <!-- Odoo stores/returns datetime fields in UTC as "yyyy-MM-dd HH:mm:ss" -->
                    <setHeader name="rangeStart">
                        <groovy>
                            def w = request.headers['watermark'] as String
                            (w ? java.time.OffsetDateTime.parse(w) : java.time.OffsetDateTime.parse('1970-01-01T00:00:00Z'))
                            .format(java.time.format.DateTimeFormatter.ofPattern('yyyy-MM-dd HH:mm:ss'))
                        </groovy>
                    </setHeader>
                    <removeHeaders pattern="*" excludePattern="watermark|rangeStart"/>
                    <!-- normalize the Odoo base URL: strip trailing slashes, add exactly one -->
                    <setHeader name="odooUrl">
                        <simple>{{vars.ODOO_BASE_URL}}</simple>
                    </setHeader>
                    <setHeader name="odooUrl">
                        <groovy>(headers.odooUrl as String).replaceAll('/+$', '') + '/'</groovy>
                    </setHeader>
                    <!-- 3. Search Odoo for product.template records updated after the watermark,
                                   PAGE BY PAGE until a non-full page comes back - so a backlog
                                   bigger than one page (e.g. 150 updated products with pageSize=100)
                                   is fully drained in THIS tick, instead of waiting for the next
                                   cron fire to pick up the remainder. -->
                    <setProperty name="pageSize">
                        <constant>100</constant>
                    </setProperty>
                    <setProperty name="pageOffset">
                        <constant>0</constant>
                    </setProperty>
                    <!-- sentinel so the FIRST loop check (evaluated BEFORE any iteration runs) passes -->
                    <setProperty name="pageFetchedCount">
                        <simple>${exchangeProperty.pageSize}</simple>
                    </setProperty>
                    <!-- tracks the max write_date actually enqueued this tick, across all
                         pages, so we can advance OUR OWN watermark after the loop -->
                    <setProperty name="maxWriteDate">
                        <groovy>null</groovy>
                    </setProperty>
                    <loop doWhile="true">
                        <!-- keep paging while the LAST page came back full; a non-full (or empty)
                             page means we reached the end of the backlog -->
                        <simple>${exchangeProperty.pageFetchedCount} == ${exchangeProperty.pageSize}</simple>
                    <setBody>
                        <groovy>
                            [
                            jsonrpc: "2.0",
                            method : "call",
                            params : [
                            service: "object",
                            method : "execute_kw",
                            args   : [
                            "{{vars.ODOO_DB}}",
                            Integer.parseInt("{{vars.ODOO_UID}}"),
                            "{{secrets.ODOO_API_KEY}}",
                            "product.template",
                            "search_read",
                            [[["write_date", "&gt;", headers.rangeStart],
                            ["sale_ok", "=", true],
                            ["active", "=", true],
                            ["type", "=", "consu"]]],
                            [
                            "fields": ["id", "name", "default_code", "description","list_price", "qty_available", "barcode", "type", "create_date", "write_date"],
                            "limit": exchangeProperty.pageSize,
                            "offset": exchangeProperty.pageOffset,
                            "order": "id desc"
                            ]
                            ]
                            ]
                            ]
                        </groovy>
                    </setBody>
                    <marshal>
                        <json library="Jackson"/>
                    </marshal>
                    <removeHeaders pattern="CamelHttp*"/>
                    <setHeader name="Content-Type">
                        <constant>application/json</constant>
                    </setHeader>
                    <setHeader name="CamelHttpMethod">
                        <constant>POST</constant>
                    </setHeader>
                    <toD uri="${header.odooUrl}jsonrpc"/>
                    <log loggingLevel="INFO" message="Odoo response (offset=${exchangeProperty.pageOffset}): ${body}"/>
                    <unmarshal>
                        <json library="Jackson"/>
                    </unmarshal>
                    <setBody>
                        <groovy>
                            def res = (body as Map)?.result ?: []
                            // Belt-and-braces: guarantee strict FIFO even if Odoo's "order" were ignored
                            res.sort { it.write_date }
                        </groovy>
                    </setBody>
                    <setProperty name="pageFetchedCount">
                        <simple>${body.size()}</simple>
                    </setProperty>
                    <!-- body is sorted ascending by write_date (see above), so its last
                         element (if any) holds this page's max write_date -->
                    <setProperty name="maxWriteDate">
                        <groovy>
                            def pageMax = (body as List) ? body[-1]?.write_date : null
                            def currentMax = exchangeProperty.maxWriteDate as String
                            (pageMax != null &amp;&amp; (currentMax == null || pageMax > currentMax)) ? pageMax : currentMax
                        </groovy>
                    </setProperty>
                    <log loggingLevel="INFO" message="Fetched ${exchangeProperty.pageFetchedCount} created/updated Odoo product(s) (offset=${exchangeProperty.pageOffset})"/>
                    <split>
                        <simple>${body}</simple>
                        <!-- Payload Structure: Odoo resource reference URL + the fields the
                                         consumer needs to order/advance the watermark; the consumer
                                         fetches the FULL product payload itself via this reference,
                                         so it is never stale by the time it is processed. -->
                        <setBody>
                            <groovy>
                                [
                                id       : body['id'],
                                write_date: body['write_date'],
                                url      : (headers.odooUrl as String) + "api/v1/products/" + body['id']
                                ]
                            </groovy>
                        </setBody>
                        <marshal>
                            <json library="Jackson"/>
                        </marshal>
                        <log loggingLevel="INFO" message="Enqueueing Odoo product ${body}"/>
                        <to uri="platform-queue://odoo-prestashop-product-sync-queue"/>
                    </split>
                        <setProperty name="pageOffset">
                            <groovy>(exchangeProperty.pageOffset as int) + (exchangeProperty.pageSize as int)</groovy>
                        </setProperty>
                    </loop>
                    <choice>
                        <when>
                            <simple>${exchangeProperty.maxWriteDate} != null</simple>
                            <!-- 3b. Advance OUR OWN "last enqueued" watermark (same
                                     storage format as the consumer's success-watermark,
                                     see product-sync-consumer.xml step 5) so a producer
                                     run that fires again before the consumer catches up
                                     never re-fetches/re-enqueues what's already queued. -->
                            <setBody>
                                <groovy>
                                    java.time.LocalDateTime.parse(exchangeProperty.maxWriteDate as String, java.time.format.DateTimeFormatter.ofPattern('yyyy-MM-dd HH:mm:ss'))
                                    .atOffset(java.time.ZoneOffset.UTC)
                                    .format(java.time.format.DateTimeFormatter.ISO_OFFSET_DATE_TIME)
                                </groovy>
                            </setBody>
                            <to uri="platform-state://product_sync_last_enqueued_timestamp?operation=put"/>
                        </when>
                    </choice>
                    <doCatch>
                        <exception>org.apache.camel.http.base.HttpOperationFailedException</exception>
                        <log loggingLevel="ERROR" message="Odoo product sync: source API returned an error. status=${exception.statusCode} url=${exception.uri} body=${exception.responseBody}"/>
                    </doCatch>
                    <doCatch>
                        <exception>java.lang.Exception</exception>
                        <log loggingLevel="ERROR" message="Odoo product sync polling failed: ${exception.message}"/>
                    </doCatch>
                    <doFinally>
                        <!-- 4. Always release the lock / reset is_odoo_product_sync_running, success or failure -->
                        <to uri="platform-lock://odoo-product-sync?operation=release"/>
                    </doFinally>
                </doTry>
            </otherwise>
        </choice>
    </route>
</routes>